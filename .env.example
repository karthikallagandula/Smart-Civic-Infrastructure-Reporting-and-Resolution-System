# CivicConnect environment template
# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets to version control.

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---------- Auth ----------
# Replace with a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------- Database ----------
# Leave empty to run the app in DEMO MODE (in-memory sample data, no persistence)
MONGODB_URI=

# ---------- Image storage (Cloudinary) ----------
# Leave empty to run in local demo upload mode (files stored in backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Optional AI features ----------
# Leave empty to use the built-in rule-based fallback (app stays fully functional)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------- Demo mode ----------
# Seed sample complaints + demo accounts when running without MongoDB
SEED_DEMO=true
